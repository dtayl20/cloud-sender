# ---------------------------------------------------------------------------
# Local development only. Copy to .dev.vars (gitignored) for `wrangler dev`
# and to .env.local (gitignored) for the Vite console.
# Never commit real values.
# ---------------------------------------------------------------------------

# Worker / local API
SMTP2GO_API_KEY=replace-me
WEBHOOK_TOKEN=replace-me-with-a-long-random-string
IP_SALT=replace-me-with-hex
SMTP2GO_WEBHOOK_URL=

# Sender identity (also settable in wrangler.toml [vars] for non-secret defaults)
DEFAULT_FROM_EMAIL=you@example.com
DEFAULT_FROM_NAME=Your Name
SEND_TIMEZONE=Australia/Brisbane

# Optional: website contact form endpoint
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_NAME=Website
CONTACT_ALLOWED_ORIGINS=http://localhost:8080
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600

# Optional: clinic report re-send webhook
REPORT_FROM_EMAIL=reports@example.com
REPORT_FROM_NAME=Reports
REPORT_SEND_TOKEN=
REPORT_TEMPLATE_ID=

# Console (Vite) — where the SPA should send API calls
VITE_API_BASE=http://localhost:8787
